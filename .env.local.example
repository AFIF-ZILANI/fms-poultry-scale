# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# Clerk — required. Sign-in will not work without it.
# Dashboard → API Keys → Publishable key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Supabase — scaffolded but not yet consumed by any screen. Safe to leave blank
# until the sync work lands.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
SUPABASE_PROJECT_ID=
